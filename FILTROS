import numpy as np
import matplotlib.pyplot as plt
from scipy.signal import butter, filtfilt, freqz

# ==========================================
# 1. DEFINICIÓN DE LA SEÑAL DE ENTRADA
# ==========================================
# Parámetros de muestreo
fs = 1000  # Frecuencia de muestreo (Hz)
t = np.linspace(0, 1.0, fs, endpoint=False)  # Vector de tiempo (1 segundo)

# Componentes de frecuencia de la señal pura (10 Hz y 120 Hz)
f1, f2 = 10, 120
seno_puro = np.sin(2 * np.pi * f1 * t) + 0.5 * np.sin(2 * np.pi * f2 * t)

# Adición de ruido blanco gaussiano
np.random.seed(42)  # Semilla para reproducibilidad
ruido = np.random.normal(0, 0.5, t.shape)
senal_con_ruido = seno_puro + ruido

# ==========================================
# 2. DISEÑO DE FILTROS (Butterworth IIR)
# ==========================================
# Término de Nyquist
nyq = 0.5 * fs

# a) Filtro Pasa Bajos (Corta todo arriba de 30 Hz)
corte_low = 30.0 / nyq
b_low, a_low = butter(N=4, Wn=corte_low, btype='low')

# b) Filtro Pasa Altos (Corta todo abajo de 80 Hz)
corte_high = 80.0 / nyq
b_high, a_high = butter(N=4, Wn=corte_high, btype='high')

# c) Filtro Pasa Bandas (Conserva entre 8 Hz y 15 Hz)
low_band, high_band = 8.0 / nyq, 15.0 / nyq
b_band, a_band = butter(N=4, Wn=[low_band, high_band], btype='bandpass')

# ==========================================
# 3. APLICACIÓN DE LOS FILTROS
# ==========================================
# Se utiliza filtfilt para evitar desfase (filtrado de fase cero)
filtrada_pasa_bajos = filtfilt(b_low, a_low, senal_con_ruido)
filtrada_pasa_altos = filtfilt(b_high, a_high, senal_con_ruido)
filtrada_pasa_bandas = filtfilt(b_band, a_band, senal_con_ruido)

# ==========================================
# 4. VISUALIZACIÓN DE RESULTADOS
# ==========================================
# FIGURA 1: Análisis en el Dominio del Tiempo
plt.figure(figsize=(12, 8))

plt.subplot(4, 1, 1)
plt.plot(t, senal_con_ruido, color='gray', alpha=0.7, label='Señal con Ruido')
plt.title('Señal Original ruidosa vs. Señales Filtradas')
plt.ylabel('Amplitud')
plt.legend(loc='upper right')
plt.grid(True)

plt.subplot(4, 1, 2)
plt.plot(t, filtrada_pasa_bajos, color='blue', label='Pasa Bajos (< 30 Hz)')
plt.ylabel('Amplitud')
plt.legend(loc='upper right')
plt.grid(True)

plt.subplot(4, 1, 3)
plt.plot(t, filtrada_pasa_altos, color='red', label='Pasa Altos (> 80 Hz)')
plt.ylabel('Amplitud')
plt.legend(loc='upper right')
plt.grid(True)

plt.subplot(4, 1, 4)
plt.plot(t, filtrada_pasa_bandas, color='green', label='Pasa Bandas (8 - 15 Hz)')
plt.xlabel('Tiempo [s]')
plt.ylabel('Amplitud')
plt.legend(loc='upper right')
plt.grid(True)

plt.tight_layout()
plt.savefig('resultado_tiempo.png')
plt.show()

# FIGURA 2: Respuesta en Frecuencia del Filtro Pasa Bajos
w, h = freqz(b_low, a_low, worN=8000)
plt.figure(figsize=(8, 4))
plt.plot(0.5 * fs * w / np.pi, np.abs(h), 'b')
plt.title('Respuesta en Frecuencia (Filtro Pasa Bajos Butterworth N=4)')
plt.xlabel('Frecuencia [Hz]')
plt.ylabel('Ganancia')
plt.grid(True)
plt.savefig('respuesta_frecuencia_pasabajos.png')
plt.show()
